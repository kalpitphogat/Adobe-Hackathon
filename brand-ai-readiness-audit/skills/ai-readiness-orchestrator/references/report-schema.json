{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/brand-ai-readiness-audit/report-schema.json",
  "title": "Brand AI-Readiness Audit report",
  "description": "The handout required floor plus this marketplace documented extensions. The floor variant in tests asserts only site, audited_at, summary counts, and findings[] with id/title/severity/evidence/suggested_action.",
  "type": "object",
  "required": ["site", "audited_at", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "site": {
      "type": "string",
      "minLength": 1,
      "description": "Registrable host of the audited origin, e.g. example.com."
    },
    "audited_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC, second precision, injected exactly once per run."
    },
    "audit_status": {
      "enum": ["complete", "partial", "no_content_available"],
      "description": "Outcome of the run. NEVER encoded in the process exit code: exit 0 means a schema-valid report was written, whatever this field says."
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "checks_available": { "type": "integer", "minimum": 0 },
        "checks_run": { "type": "integer", "minimum": 0 },
        "ai_bots_snapshot_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "ai_bots_source_commit": { "type": "string" },
        "tool_versions": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "critical", "high", "medium"],
      "additionalProperties": false,
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "blocked_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings capped and tagged blocked_by because an upstream gate is closed. Counted inside total_findings."
        },
        "suppressed_by_rule": {
          "type": "array",
          "description": "Transparency: what we deliberately did NOT report, and why.",
          "items": {
            "type": "object",
            "required": ["rule", "check_id", "count"],
            "additionalProperties": false,
            "properties": {
              "rule": { "type": "string" },
              "check_id": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string" }
            }
          }
        },
        "by_category": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discoverability": { "type": "integer", "minimum": 0 },
            "engagement": { "type": "integer", "minimum": 0 }
          }
        },
        "by_stage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reach": { "type": "integer", "minimum": 0 },
            "read": { "type": "integer", "minimum": 0 },
            "extract": { "type": "integer", "minimum": 0 },
            "trust": { "type": "integer", "minimum": 0 },
            "act": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "evidence", "suggested_action"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Concrete, quantified, quoted. Counts and URLs. Never a restatement of the title."
          },
          "suggested_action": {
            "type": "object",
            "required": ["summary", "priority"],
            "additionalProperties": false,
            "properties": {
              "summary": { "type": "string", "minLength": 1 },
              "priority": { "enum": ["critical", "high", "medium", "low"] },
              "effort": { "enum": ["low", "medium", "high"] },
              "ice": { "type": "number", "minimum": 0, "maximum": 10 },
              "ice_components": {
                "type": "object",
                "required": ["impact", "confidence", "ease"],
                "additionalProperties": false,
                "properties": {
                  "impact": { "type": "number", "minimum": 1, "maximum": 10 },
                  "confidence": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 10,
                    "description": "Deterministic map from the finding confidence enum: confirmed=9, likely=6, hypothesis=3. Never a second judgement."
                  },
                  "ease": { "type": "number", "minimum": 1, "maximum": 10 }
                }
              },
              "mechanism": {
                "type": "string",
                "minLength": 1,
                "description": "One sentence on WHY the fix works, mechanistically."
              },
              "source": { "type": "string" },
              "patch": {
                "type": "string",
                "description": "Paste-ready content built ONLY from values present in the evidence bundle. Absent values appear as __FILL_IN__:<property>, never as invented placeholders."
              },
              "patch_path": { "type": "string" },
              "verification": {
                "type": "string",
                "description": "The exact command or check that confirms the fix landed."
              }
            }
          },
          "check_id": {
            "type": "string",
            "pattern": "^(reach|read|extract|trust|act)[.][a-z0-9_]+[.][a-z0-9_]+$"
          },
          "confidence": { "enum": ["confirmed", "likely", "hypothesis"] },
          "category": { "enum": ["discoverability", "engagement"] },
          "stage": { "enum": ["reach", "read", "extract", "trust", "act"] },
          "blocked_by": { "type": ["string", "null"] },
          "affected_urls": { "type": "array", "items": { "type": "string" } },
          "affected_url_count": { "type": "integer", "minimum": 0 },
          "merged_from": {
            "type": "array",
            "items": { "type": "string" },
            "description": "check_ids deduped into this finding."
          }
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "description": "Beyond-defect improvements. Not findings; never gated, never capped.",
      "items": {
        "type": "object",
        "required": ["id", "title", "rationale", "suggested_action"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^P-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "applies_to_archetype": { "type": "array", "items": { "type": "string" } },
          "suggested_action": { "$ref": "#/properties/findings/items/properties/suggested_action" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "description": "What the audit could not assess, and why. Required whenever any capability degraded or any check was suppressed for absent evidence.",
      "items": {
        "type": "object",
        "required": ["scope", "reason", "checks_not_run"],
        "additionalProperties": false,
        "properties": {
          "scope": { "type": "string", "description": "The literal string site, or a specific URL." },
          "reason": { "type": "string", "minLength": 1 },
          "checks_not_run": { "type": "array", "items": { "type": "string" } },
          "confidence_effect": { "type": "string" },
          "optional_feature": {
            "type": "boolean",
            "description": "True when this gap exists only because an opt-in flag was not set. Such a gap does NOT downgrade audit_status, because the audit ran exactly as configured."
          }
        }
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "pages_fetched": { "type": "integer", "minimum": 0 },
        "pages_rendered": { "type": "integer", "minimum": 0 },
        "degraded_capabilities": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
